              <Program>/*
 * 
 * /////////////////////////////////////////////////////
 *     Optional Home script for Auto Docking 2.0
 *     
 *     Author:  Spug
 *     Please leave credit if the ship is
 *     used on the workshop.
 * /////////////////////////////////////////////////////
 */



//CHANGEABLE VARIABLES:

public bool override_antenna_check = false;   // If you are certain there's an available antenna but the script is saying there isn't, set to true.


// Please don't change after this:

public IMyRadioAntenna antenna = null;
public IMyShipController cockpit;
IMyBroadcastListener _myBroadcastListener;
public bool error_state = false;
public bool waitingForEnabledAntenna = false;
public string echostring = "";
public string status = "ERROR";
// DO NOT CHANGE THESE BELOW: !
const string _responseTag = "Spug's position update response";
const string _incomingTag = "Spug's position update request";
const string _recallRequestTag = "Spug's recall request";
public List&lt;IMyTerminalBlock&gt; blocks = new List&lt;IMyTerminalBlock&gt;();
// Acceleration variables:
public DateTime lastVelocityPoll;
public Vector3D lastVelocity;

public Program()
{
    GridTerminalSystem.GetBlocks(blocks);
    _myBroadcastListener = IGC.RegisterBroadcastListener(_incomingTag);
    _myBroadcastListener.SetMessageCallback(_incomingTag);
    CheckBasicData();
    if(error_state == false)
    {
        EchoFinish();
    }

}
public Vector3D calculateAcceleration()
{
    if(cockpit != null)
    {
        Vector3D currentVelocity = cockpit.GetShipVelocities().LinearVelocity;
        Vector3D calculatedAcc = Vector3D.Zero;

        double secondsSinceLastPoll = (DateTime.Now - lastVelocityPoll).TotalSeconds;
        if(secondsSinceLastPoll &lt; 2)
        {
            calculatedAcc = (currentVelocity - lastVelocity) / secondsSinceLastPoll;
        }

        lastVelocity = currentVelocity;
        lastVelocityPoll = DateTime.Now;

        return calculatedAcc;
    }
    else
    {
        return Vector3D.Zero;
    }
}

static string stringifyArgument(string arg)
{
    if (arg == "")
    {
        return "No argument";
    }
    else
    {
        return arg;
    }
}
public void Main(string argument, UpdateType updateSource)
{
    if ((updateSource &amp; (UpdateType.Trigger | UpdateType.Terminal | UpdateType.Script)) != 0)
    {
        //Echo2("Re-Initialized");
        //CheckBasicData();
        if (error_state)
        {
            CheckBasicData();
        }
        if (!error_state)
        {
            RequestRecall(argument);
            EchoFinish();
        }
    }
    if ((updateSource &amp; UpdateType.Update100) != 0)
    {
        CheckBasicData();
        EchoFinish();
    }
    if ((updateSource &amp; UpdateType.IGC) &gt; 0)
    {
        // Has recieved a message
        while (_myBroadcastListener.HasPendingMessage)
        {
            MyIGCMessage myIGCMessage = _myBroadcastListener.AcceptMessage();
            if (myIGCMessage.Tag == _incomingTag)
            {
                if (myIGCMessage.Data is string)
                {
                    string str = myIGCMessage.Data.ToString();
                    //Echo2("I detect that a ship is coming to dock here.");
                    SendResponse(myIGCMessage.Source, str);
                }
                else // if(msg.Data is XXX)
                {
                }
            }
        }
        //EchoFinish();
    }
}


public void RequestRecall(string arg)
{
    Echo2("- Broadcasting a message to tell any ships with the argument: " + stringifyArgument(arg) + "\nto dock immediately...");

    IGC.SendBroadcastMessage(_recallRequestTag, arg + ";" + Me.CubeGrid.EntityId.ToString());

    Echo2("\n- Broadcast complete.");
}

public void SendResponse(long source, string shipdata)
{
    string[] data_parts = shipdata.Split(';');

    // Get required data for the connector.
    long connector_id = 0;
    long grid_id = 0;
    long.TryParse(data_parts[1], out grid_id);
    long.TryParse(data_parts[0], out connector_id);

    IMyShipConnector connector_in_question = (Sandbox.ModAPI.Ingame.IMyShipConnector)GridTerminalSystem.GetBlockWithId(connector_id);

    if (connector_in_question == null &amp;&amp; grid_id == Me.CubeGrid.EntityId)
    {
        IGC.SendUnicastMessage(source, _responseTag, "Warning!\nThe home connector could no longer be found by the optional home script.");
    }
    if (connector_in_question != null)
    {
        Vector3D velocity = Vector3D.Zero;
        Vector3D ang_velocity = Vector3D.Zero;
        Vector3D acceleration = calculateAcceleration();
        if (cockpit != null)
        {
            velocity = cockpit.GetShipVelocities().LinearVelocity;
            ang_velocity = cockpit.GetShipVelocities().AngularVelocity;
        }

        string connector_data = "";
        connector_data += connector_in_question.GetPosition().ToString() + ";";
        connector_data += connector_in_question.WorldMatrix.Forward.ToString() + ";";
        connector_data += connector_in_question.WorldMatrix.Left.ToString() + ";";
        connector_data += velocity.ToString() + ";";
        connector_data += ang_velocity.ToString() + ";";
        connector_data += acceleration.ToString();

        IGC.SendUnicastMessage(source, _responseTag, connector_data);

        //IGC.SendBroadcastMessage(_responseTag, "This is a position update from: " + Me.CustomName);
        //Echo2("Sent response back");
    }

}
public void CheckBasicData()
{
    Runtime.UpdateFrequency = UpdateFrequency.None;

    cockpit = FindCockpit();


    int antenna_found_success = 0;
    foreach (var block in blocks)
    {
        if (block is IMyRadioAntenna &amp;&amp; blockIsOnMyGrid(block))
        {
            IMyRadioAntenna my_antenna = (IMyRadioAntenna)block;
            if(antenna_found_success &lt; 1)
            {
                antenna_found_success = 1;
                antenna = my_antenna;
            }
            if (my_antenna.Enabled &amp;&amp; antenna_found_success &lt; 2)
            {
                antenna_found_success = 2;
                antenna = my_antenna;
            }
            if (my_antenna.EnableBroadcasting &amp;&amp; my_antenna.Enabled &amp;&amp; antenna_found_success &lt; 3)
            {
                antenna_found_success = 3;
                antenna = my_antenna;
            }
        }
    }

    if (override_antenna_check)
    {
        antenna_found_success = 3;
    }

    if (antenna_found_success == 0)
        Error2("I could not find an antenna on your ship, Captain!\nThis script requires a working antenna to operate.");
    if (antenna_found_success == 1)
    {
        waitingForEnabledAntenna = true;
        Echo2("Warning:\nThe antenna I found: " + antenna.CustomName + ", is not enabled.\nI will automatically notice when the antenna is re-enabled, for your convenience.\nThis script won't be able to operate while it's disabled however.");
        status = "AUTO-PAUSED";
        Runtime.UpdateFrequency = UpdateFrequency.Update100;
    }
    if (antenna_found_success == 2)
    {
        waitingForEnabledAntenna = true;
        Echo2("Warning:\nThe antenna I found: " + antenna.CustomName + ", is not broadcasting.\nI will automatically notice when the antenna is broadcasting, for your convenience.\nThis script won't be able to operate while it isn't broadcasting however.");
        status = "AUTO-PAUSED";
        Runtime.UpdateFrequency = UpdateFrequency.Update100;
    }
    if(antenna_found_success == 3)
    {
        waitingForEnabledAntenna = false;
        status = "RUNNING";
        Echo2("This script is set-up correctly and is running.");
    }
}
public bool blockIsOnMyGrid(IMyTerminalBlock block)
{
    return block.CubeGrid.EntityId == Me.CubeGrid.EntityId;
}
public void Echo2(object echo_text)
{
    echostring += echo_text.ToString() + "\n";
}
public void Error2(object echo_text)
{
    echostring = "";
    Echo2(echo_text.ToString());
    error_state = true;
    status = "ERROR";
    EchoFinish();
}
public void EchoFinish()
{
    string echoline = "= Spug's Optional Home Script 2 =\n\n" + status + "\n" + echostring;
    Echo(echoline);


    IMyTextSurface surface = GridTerminalSystem.GetBlockWithName("LCD Panel") as IMyTextSurface;
    if (surface != null)
    {
        surface.ContentType = ContentType.TEXT_AND_IMAGE;
        surface.FontSize = 1f;
        surface.Alignment = VRage.Game.GUI.TextPanel.TextAlignment.LEFT;
        surface.WriteText(echoline);
    }

    echostring = "";
}





IMyShipController FindCockpit()
{
    List&lt;IMyShipController&gt; cockpits = new List&lt;IMyShipController&gt;();
    IMyShipController foundCockpit = null;
    bool foundMainCockpit = false;
    foreach (var block in blocks)
    {
        if (block is IMyShipController &amp;&amp; blockIsOnMyGrid(block))
        {
            if (foundCockpit == null)
            {
                foundCockpit = (IMyShipController)block;
            }
            if (block is IMyCockpit)
            {
                IMyCockpit c_cockpit = (IMyCockpit)block;

                if (foundMainCockpit == false)
                {
                    foundCockpit = (IMyShipController)block;
                }
                if (c_cockpit.IsMainCockpit == true)
                {
                    foundMainCockpit = true;
                    foundCockpit = (IMyShipController)block;
                }
            }
            if (block is IMyRemoteControl &amp;&amp; foundMainCockpit == false)
            {
                foundCockpit = (IMyShipController)block;
            }
        }
    }
    return foundCockpit;
}</Program>
